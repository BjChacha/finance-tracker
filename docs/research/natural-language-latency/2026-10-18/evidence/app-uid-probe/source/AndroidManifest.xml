<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.chacha.nlprobe">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Local inference probe" android:debuggable="true"
        android:allowBackup="false" android:extractNativeLibs="true"
        android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <activity android:name=".MainActivity" android:exported="true" />
    </application>
</manifest>
