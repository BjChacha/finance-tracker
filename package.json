    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.3",
    "expo-sharing": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "iconv-lite": "^0.7.3",
    "papaparse": "^5.5.4",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gifted-charts": "^1.4.77",
