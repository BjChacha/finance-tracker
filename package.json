{
  "name": "finance-tracker",
  "version": "0.0.3",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/datetimepicker": "^9.1.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.2",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-glass-effect": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.9",
    "expo-sharing": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "iconv-lite": "^0.7.3",
    "lucide-react-native": "^1.26.0",
    "papaparse": "^5.5.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "string_decoder": "^1.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^57.0.2",
    "drizzle-kit": "^0.31.10",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "build:apk": "node scripts/build-apk.mjs",
    "release": "node scripts/release.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/__tests__/**/*.mjs",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-gifted-charts|gifted-charts-core|@shopify/flash-list|react-native-reanimated|react-native-worklets|react-native-gesture-handler|lucide-react-native))"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.mjs$": "babel-jest"
    }
  },
  "private": true
}
