+// Split only complete, aligned two-dimensional Q4_0 weights into independent column tiles.
+// Keep the original serial path as the default and for partial or padded tensors.
+static bool repack_q4_0_tiled_parallel(ggml_tensor * tensor, const void * data, size_t size) {
+    const char * setting = getenv("GGML_HEXAGON_REPACK_THREADS");
+    if (!setting || tensor->type != GGML_TYPE_Q4_0 || size < 1024 * 1024 ||
+            tensor->ne[2] != 1 || tensor->ne[3] != 1 || tensor->ne[1] % 32 != 0) {
+        return false;
+    }
+    char * end = nullptr;
+    const long requested = strtol(setting, &end, 10);
+    if (end == setting || *end != '\0' || requested <= 1) {
+        return false;
+    }
+    const size_t row_bytes = ggml_row_size(tensor->type, tensor->ne[0]);
+    if (size != row_bytes * tensor->ne[1]) {
+        return false;
+    }
+    const int64_t tiles = tensor->ne[1] / 32;
+    const int workers_count = (int) std::min<int64_t>(std::min<long>(requested, 8), tiles);
+    if (workers_count <= 1) {
+        return false;
+    }
+    auto repack_part = [&](int worker) {
+        const int64_t first_row = (tiles * worker / workers_count) * 32;
+        const int64_t last_row = (tiles * (worker + 1) / workers_count) * 32;
+        ggml_tensor part = *tensor;
+        part.ne[1] = last_row - first_row;
+        part.nb[2] = part.nb[3] = part.ne[1] * row_bytes;
+        part.data = (uint8_t *) tensor->data + first_row * row_bytes;
+        repack_q4_0_tiled(&part, (const uint8_t *) data + first_row * row_bytes, 0, part.ne[1] * row_bytes);
+    };
+    std::vector<std::thread> workers;
+    workers.reserve(workers_count - 1);
+    int next_worker = 1;
+    try {
+        for (; next_worker < workers_count; ++next_worker) {
+            workers.emplace_back(repack_part, next_worker);
+        }
+    } catch (const std::system_error &) {
+        // Finish unstarted partitions on the caller if the process cannot create more threads.
+        for (; next_worker < workers_count; ++next_worker) {
+            repack_part(next_worker);
+        }
+    }
+    repack_part(0);
+    for (auto & worker : workers) {
+        worker.join();
+    }
+    return true;
+}
